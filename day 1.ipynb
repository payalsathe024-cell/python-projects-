     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Student Name: Payal\n"
     ]
    }
   ],
   "source": [
    "class Student:\n",
    "    def __init__(self):\n",
    "        self.name = \"Payal\"\n",
    "    def display(self):\n",
    "        print(\"Student Name:\", self.name)\n",
    "student = Student()\n",
    "student.display()"
   ]
